# Ambiente: development, test ou production
NODE_ENV=development

# Porta do servidor
PORT=3000

# Banco de dados. Em desenvolvimento usamos SQLite (arquivo dentro de prisma/).
# Em produção, use a URL do PostgreSQL (veja docs/deploy.md).
DATABASE_URL="file:./dev.db"

# Segredo usado para assinar o cookie da sessão (no mínimo 32 caracteres).
# Gere um com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="troque-este-valor-por-um-segredo-com-32-caracteres-ou-mais"

# Quantas tentativas de login um mesmo IP pode fazer a cada 15 minutos
LIMITE_TENTATIVAS_LOGIN=10

# Custo do bcrypt (quanto maior, mais lento e mais seguro). 12 é um bom valor.
CUSTO_BCRYPT=12
