<%- include('../partials/menu-comissao') %>
<div class="cabecalho-pagina">
  <div>
    <h1><%= titulo %></h1>
    <p>O aviso urgente mais recente aparece numa faixa no topo de todas as páginas.</p>
  </div>
  <a class="botao botao--principal" href="/comissao/avisos/novo">Novo aviso</a>
</div>

<% if (avisos.length === 0) { %>
<div class="vazio"><p>Nenhum aviso cadastrado.</p></div>
<% } else { %>
<div class="tabela-rolavel">
  <table class="tabela">
    <caption class="visualmente-oculto">Avisos</caption>
    <thead>
      <tr>
        <th scope="col">Título</th>
        <th scope="col">Publicação</th>
        <th scope="col">Marcações</th>
        <th scope="col"><span class="visualmente-oculto">Ações</span></th>
      </tr>
    </thead>
    <tbody>
      <% for (const aviso of avisos) { %>
      <tr>
        <td><%= aviso.titulo %></td>
        <td>
          <%= datas.formatarDataHora(aviso.publicadoEm) %>
          <% if (aviso.publicadoEm > agora) { %><span class="etiqueta etiqueta--neutra">Agendado</span><% } %>
        </td>
        <td class="acoes">
          <% if (aviso.fixado) { %><span class="etiqueta etiqueta--neutra">Fixado</span><% } %>
          <% if (aviso.urgente) { %><span class="etiqueta etiqueta--urgente">Urgente</span><% } %>
          <% if (!aviso.fixado && !aviso.urgente) { %>—<% } %>
        </td>
        <td class="acoes">
          <a href="/comissao/avisos/<%= aviso.id %>/editar">Editar<span class="visualmente-oculto"> <%= aviso.titulo %></span></a>
          <a href="/comissao/avisos/<%= aviso.id %>/excluir">Excluir<span class="visualmente-oculto"> <%= aviso.titulo %></span></a>
        </td>
      </tr>
      <% } %>
    </tbody>
  </table>
</div>
<% } %>
